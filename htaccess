# Always revalidate pages, scripts, styles and version.json so a deploy reaches users immediately.
# (Revalidation is cheap: unchanged files come back as 304 using the ETag.)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
